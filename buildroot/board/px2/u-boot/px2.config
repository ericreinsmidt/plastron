# Changes on top of ROCKNIX's rk3326-handheld_defconfig.

# Boot at once. ROCKNIX waits 1 s for a key on the serial console, which on
# this device nobody can reach; -2 skips even the check for one.
CONFIG_BOOTDELAY=-2

# Timing: U-Boot records when each of its stages happens and leaves the
# record in the device tree it gives Linux, readable afterwards under
# /proc/device-tree/bootstage. How the bootloader gets measured without a
# serial console.
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
CONFIG_BOOTSTAGE_RECORD_COUNT=100

# A smaller U-Boot: Rockchip's miniloader reads it off the card before it
# runs, and it initializes less. None of this is used on this device:
# networking, USB (host, gadget, fastboot), the display stack, SPI flash,
# and the environment in MMC (reading it costs a card access at every boot,
# to find nothing saved).
CONFIG_NO_NET=y
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_FASTBOOT is not set
# CONFIG_CMD_USB is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_VIDEO is not set
# CONFIG_DISPLAY is not set
# CONFIG_BACKLIGHT is not set
# CONFIG_SPI_FLASH is not set
# CONFIG_ROCKCHIP_SFC is not set
# CONFIG_CMD_SF is not set
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_OPTEE_LIB is not set
# CONFIG_LZO is not set
