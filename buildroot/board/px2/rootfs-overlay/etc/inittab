# The base system's inittab, in place of Buildroot's default. TortOS's
# (board/tortos/rootfs-overlay/etc/inittab) replaces it in the TortOS image,
# and is this plus its splash, so keep the two in step.
#
# There's no remount of / (the kernel mounts it read-write already, and doing
# it again cost 90 ms), no swapon (there is no swap), and no getty on tty1
# (with the kernel console off, nothing on screen would show it).

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
# The card's games partition, ahead of rcS: see the script
::sysinit:/etc/init.d/datapart start
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# A press of the power button shuts down cleanly
::respawn:/usr/sbin/powerkey
::respawn:/usr/sbin/jackswitch
::respawn:/usr/sbin/usbrole

# Busybox runs these before it kills the remaining processes, so stop them
# here first: anything still holding a file open for writing (a program
# using Mesa's shader cache) made the read-only remount fail, and every next boot
# then replayed the ext4 journal, 400 ms of mounting root. The card's
# partition is unmounted on its own, waiting for whatever uses it to go (see
# datapart).
::shutdown:/etc/init.d/rcK
::shutdown:/bin/kill -TERM -1
::shutdown:/bin/usleep 200000
::shutdown:/etc/init.d/datapart stop
::shutdown:/bin/umount -a -r
