#!/bin/sh
# The card's third partition, for games, saves and music: exFAT, so a Mac or
# PC can read and write it. The card image only has boot and root, so on the
# first boot this adds the partition over the rest of the card, whatever its
# size, and formats it. Every boot after that just mounts it.
#
# Run by init straight after the basic mounts (see /etc/inittab), not by rcS
# with the other startup scripts: TortOS needs this and nothing else from
# them, and starts the moment it is done. `stop` unmounts it at shutdown.
#
# The label comes from /etc/default/datapart (DATA_LABEL=...), if there is one.

CARD=/dev/mmcblk0
DATA=${CARD}p3
MOUNT=/mnt/SDCARD
DATA_LABEL=PIXEL2
[ -r /etc/default/datapart ] && . /etc/default/datapart

create() {
	echo "datapart: first boot, adding $DATA over the rest of the card" > /dev/kmsg
	# Right after root, on a 4 MiB boundary (the card's erase blocks). The
	# start has to be given: left to itself, sfdisk takes the first free
	# gap, which is the bootloader's, between sector 64 and boot at 16 MiB.
	# Type 7 is exFAT in an MBR table; the size is the rest of the card.
	root=/sys/block/mmcblk0/mmcblk0p2
	start=$(( $(cat $root/start) + $(cat $root/size) ))
	start=$(( (start + 8191) / 8192 * 8192 ))
	echo "start=$start, type=7" | sfdisk --quiet --append --no-reread $CARD || return 1
	# Root is mounted, so the kernel won't re-read the whole table; add the
	# one partition instead
	partx --add --nr 3 $CARD || return 1
	mkfs.exfat -L "$DATA_LABEL" $DATA > /dev/null || return 1
	echo "datapart: $DATA formatted as exFAT, label $DATA_LABEL" > /dev/kmsg
}

# A partition that was not unmounted cleanly (a flat battery, a pulled cable)
# is checked and repaired before it is mounted. Linux will not do it, and will
# not forget it either: a volume that is dirty when mounted stays dirty for
# good, however cleanly it is unmounted after (fs/exfat keeps the flag as
# persistent), so one bad power-off had every later boot warning that the
# card needed fsck - seen 2026-10-02 after shutdowns that unmounted fine. The
# flag is bit 1 of VolumeFlags, byte 106 of the boot sector: one od, so a
# clean boot pays for reading one byte.
repair() {
	flags=$(od -An -tu1 -j106 -N1 $DATA)
	[ $(( flags & 2 )) -eq 0 ] && return
	echo "datapart: $DATA was not unmounted cleanly; checking it" > /dev/kmsg
	fsck.exfat -p $DATA > /dev/null 2>&1
	echo "datapart: fsck.exfat finished with status $?" > /dev/kmsg
}

start() {
	new=
	if [ ! -b $DATA ]; then
		create || {
			echo "datapart: couldn't create $DATA" > /dev/kmsg
			return 1
		}
		new=1
	else
		repair
	fi
	mkdir -p $MOUNT
	mount -t exfat -o noatime $DATA $MOUNT || return 1
	# Keeps a Mac from building a Spotlight index of the whole card
	if [ -n "$new" ]; then
		touch $MOUNT/.metadata_never_index
	fi
}

# At shutdown, after init's SIGTERM, as soon as nothing is using it. The
# programs that run from the card take a moment to go: Diatom took 280 ms,
# measured 2026-10-02, and the 200 ms init waited before its umount -a was
# too short every time - the umount failed, the read-only remount it falls
# back to leaves an exFAT volume dirty, and the next boot had to repair it.
# Tried every 50 ms, so it waits only as long as they need, up to 3 s; past
# that it is left to the repair at the next boot.
stop() {
	grep -q " $MOUNT " /proc/mounts || return 0
	n=0
	until umount $MOUNT 2>/dev/null; do
		n=$((n + 1))
		if [ $n -ge 60 ]; then
			echo "datapart: $MOUNT still in use after 3 s, left for the next boot to check" > /dev/kmsg
			return 1
		fi
		usleep 50000
	done
}

case "$1" in
start) start ;;
stop) stop ;;
esac
