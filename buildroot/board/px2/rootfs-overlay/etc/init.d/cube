#!/bin/sh
# kmscube, for showing off the GPU. With TortOS's splash in the image, it
# waits for the splash: the splash lets go of the display once its picture is
# up and logs "splash: panel lit"; kmscube then takes the display over and
# replaces the picture. kmscube quits on any input, so it gets an input that
# never sends any.
start() {
	# /dev/kmsg hands out each log line as it arrives, blocking in
	# between, so this sleeps until the splash's line rather than polling
	[ -x /usr/bin/splash ] && grep -q "splash: panel lit" < /dev/kmsg
	echo "cube: kmscube starting at $(cut -d' ' -f1 /proc/uptime) s" > /dev/kmsg
	tail -f /dev/null | kmscube > /dev/null 2>&1
}

[ "$1" = start ] && start &
