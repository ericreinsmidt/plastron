# Our changes to ROCKNIX's RK3326 kernel config (linux.config.rocknix).
# scripts/kernel-config.sh applies them to make linux.config. Before these,
# it turns every module off: nothing loads modules here, so what ROCKNIX
# builds as one either moves into the kernel below or goes.

# No modules at all
# CONFIG_MODULES is not set

# Built in rather than modules: what this device needs from ROCKNIX's list
CONFIG_JOYSTICK_ROCKNIX_SINGLEADC=y
CONFIG_EXFAT_FS=y
CONFIG_DRM_PANFROST=y

# Only the PX30's clock driver: ROCKNIX's config builds every Rockchip SoC's
# CONFIG_CLK_RV1126B is not set
# CONFIG_CLK_RK3308 is not set
# CONFIG_CLK_RK3328 is not set
# CONFIG_CLK_RK3368 is not set
# CONFIG_CLK_RK3399 is not set
# CONFIG_CLK_RK3528 is not set
# CONFIG_CLK_RK3562 is not set
# CONFIG_CLK_RK3568 is not set
# CONFIG_CLK_RK3576 is not set
# CONFIG_CLK_RK3588 is not set

# Display: the VOP and MIPI DSI, nothing else. The panel driver is ROCKNIX's
# generic-dsi (patch 4), always built in.
# CONFIG_ROCKCHIP_ANALOGIX_DP is not set
# CONFIG_ROCKCHIP_CDN_DP is not set
# CONFIG_ROCKCHIP_DW_HDMI is not set
# CONFIG_ROCKCHIP_INNO_HDMI is not set
# CONFIG_ROCKCHIP_LVDS is not set
# CONFIG_ROCKCHIP_RGB is not set
# CONFIG_ROCKCHIP_RK3066_HDMI is not set
# CONFIG_DRM_PANEL_ELIDA_KD35T133 is not set
# CONFIG_DRM_PANEL_NEWVISION_NV3051D is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7701 is not set
# CONFIG_DRM_PANEL_SITRONIX_ST7703 is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_LOGO is not set

# PHYs: USB and the DSI D-PHY only
# CONFIG_PHY_ROCKCHIP_DP is not set
# CONFIG_PHY_ROCKCHIP_DPHY_RX0 is not set
# CONFIG_PHY_ROCKCHIP_EMMC is not set
# CONFIG_PHY_ROCKCHIP_INNO_HDMI is not set
# CONFIG_PHY_ROCKCHIP_PCIE is not set
# CONFIG_PHY_ROCKCHIP_TYPEC is not set
# CONFIG_PHY_ROCKCHIP_USB is not set

# Sound: the RK817 codec through the I2S controller and simple-card
# CONFIG_SND_SOC_ES8316 is not set
# CONFIG_SND_SOC_ES8328 is not set
# CONFIG_SND_SOC_ES8328_I2C is not set
# CONFIG_SND_SOC_ES8328_SPI is not set
# CONFIG_SND_SOC_MAX98357A is not set
# CONFIG_SND_SOC_SPDIF is not set
# CONFIG_SND_SOC_DMIC is not set

# Input: no rumble (TortOS doesn't use it, and its driver held up boot),
# touchscreens, mice or other boards' joypads
# CONFIG_INPUT_PWM_VIBRA is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_JOYSTICK_ODROIDGO2 is not set
# CONFIG_JOYSTICK_ODROIDGO2_V11 is not set
# CONFIG_JOYSTICK_ODROIDGO3 is not set
# CONFIG_JOYSTICK_RGB20S is not set
# CONFIG_JOYSTICK_XU10 is not set
# CONFIG_JOYSTICK_GAMEFORCE_CHI is not set

# USB: device mode for development (the gadget), no host side. Nothing is
# plugged into the port in use, and USB gamepads and storage aren't wanted.
# CONFIG_HID_SUPPORT is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_USB_NET_DRIVERS is not set

# Filesystems: ext4 for root, FAT for boot, exFAT for games
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_PSTORE is not set
# CONFIG_NETWORK_FILESYSTEMS is not set

# Storage the device doesn't have
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_MD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NBD is not set

# Networking: only what USB networking and SSH over it need
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_RFKILL is not set
# CONFIG_BT is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_WIREGUARD is not set
# CONFIG_TUN is not set
# CONFIG_ETHERNET is not set
# CONFIG_PPP is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_IP_PNP is not set
# CONFIG_INET_ESP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set

# Hardware video codecs
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set

# What systemd and general-purpose distributions need, and busybox doesn't
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_IKCONFIG is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_WATCHDOG is not set

# The kernel's deterministic random generator, which nothing here uses (it's
# for the likes of Bluetooth pairing), and the jitter-entropy source it pulls
# in, whose self-test took 145 ms of boot
# CONFIG_CRYPTO_DRBG_MENU is not set
# CONFIG_CRYPTO_JITTERENTROPY is not set

# No framebuffer console. It did the first mode-set (the panel's 0.7 s
# power-up) under the console lock, which held up init; patch 6 has the
# DRM driver set fbdev's mode from a work item instead. For kernel messages
# on screen while debugging, turn this back on (and see boot.cmd).
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Second pass, from measuring what's still big in the built kernel.

# cgroups and what drags them in: SCHED_AUTOGROUP (a desktop scheduling
# tweak) selects them, and PSI and the memory, block and CPU controllers
# are only for service managers
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_PSI is not set
# CONFIG_MEMCG is not set
# CONFIG_BLK_CGROUP is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_CPUSETS is not set

# Kernel log: 16 KiB, not 128. The ring buffer's index alone was 352 KiB.
CONFIG_LOG_BUF_SHIFT=14
CONFIG_LOG_CPU_MAX_BUF_SHIFT=12

# No initramfs, so no decompressors for one; zstd and LZO came in through
# the crypto API for features (zram, zswap) not used here
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_CRYPTO_LZO is not set

# USB: device only, for development's USB networking (ECM). No host side,
# and so no role switch, and no other gadget types.
# CONFIG_USB_DWC2_DUAL_ROLE is not set
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB is not set
# CONFIG_USB_CONFIGFS_NCM is not set
# CONFIG_USB_CONFIGFS_RNDIS is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_FS is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_SERIAL is not set

# Nothing uses a console now: no virtual terminals, no serial port driver
# (the UART has no one on the other end without soldering)
# CONFIG_VT is not set
# CONFIG_SERIAL_8250 is not set

# Unused here: io_uring, SPI (no SPI devices), Unicode case-folding
# tables, suspend and hibernate (the device is powered off, never
# suspended), and perf events
# CONFIG_IO_URING is not set
# CONFIG_SPI is not set
# CONFIG_UNICODE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# ROCKNIX's driver for the chip's suspend sleep modes, useless without suspend
# (and it won't build without it)
# CONFIG_ROCKCHIP_PM_CONFIG is not set
# ARM's hardware tracing, which also selects perf events
# CONFIG_CORESIGHT is not set
# CONFIG_PERF_EVENTS is not set
