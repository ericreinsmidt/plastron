# Changes to Buildroot's BusyBox config (package/busybox/busybox.config).
#
# No system logger, kernel logger or cron: TortOS logs to the card, the
# kernel's log is in dmesg, and nothing is scheduled. Each was a process
# started during boot, beside TortOS, for nothing.
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_CROND is not set

# A DHCP server for the USB cable, so the computer on the other end gets an
# address and Down to the Wire has one a browser opens (S40usbgadget).
CONFIG_UDHCPD=y
CONFIG_DHCPD_LEASES_FILE="/var/lib/misc/udhcpd.leases"

# tar's -z, for TortOS's Download logs (a .tar.gz), which failed with tar
# saying 'invalid option -- z'. gzip itself was already in.
CONFIG_FEATURE_SEAMLESS_GZ=y
