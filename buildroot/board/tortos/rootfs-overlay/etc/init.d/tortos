#!/bin/sh
# TortOS, from the card's games partition (mounted at /mnt/SDCARD by
# S10datapart, which is why init runs this after rcS). TortOS's own files live
# there, as on the Brick, so it is updated by copying files onto the card.
#
# TortOS handles the power button itself (it saves a running game first), so
# powerkey only runs when there is no TortOS on the card to do it.
LAUNCH=/mnt/SDCARD/TortOS/launch.sh

if [ -f "$LAUNCH" ]; then
	exec sh "$LAUNCH"
fi
echo "tortos: no $LAUNCH; the splash stays and power works" > /dev/kmsg
exec /usr/sbin/powerkey
