# TortOS on top of the base Pixel 2 system (configs/px2_defconfig).
# scripts/build.sh merges this into the base config for the TortOS image.

BR2_TARGET_GENERIC_ISSUE="TortOS"

# The base overlay first, then TortOS's, whose files win (its inittab starts
# the splash first)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay $(BR2_EXTERNAL_PX2_PATH)/board/tortos/rootfs-overlay"

# TortOS's boot screen, the moment the panel lights
BR2_PACKAGE_SPLASH=y

# Libraries TortOS and Diatom load. SDL2_image with PNG and JPEG (box art and
# cards), SDL2_ttf for text, sqlite for settings and zlib for RetroAchievements
# hashing (both loaded at runtime), FFmpeg for Muse's music and audiobooks.
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y

# TortOS and Diatom themselves, built from their own repositories (mounted
# into the build container; see the Makefile)
BR2_PACKAGE_TORTOS=y
BR2_PACKAGE_DIATOM=y
