diff -ruN a/src/video/pvrfb/SDL_pvrfbvideo.c b/src/video/pvrfb/SDL_pvrfbvideo.c
--- a/src/video/pvrfb/SDL_pvrfbvideo.c
+++ b/src/video/pvrfb/SDL_pvrfbvideo.c
@@ -0,0 +1,197 @@
+/*
+  PowerVR on the Linux framebuffer: SDL video for Imagination's EGL with the
+  null window system (libpvrNULL_WSEGL), as on the TrimUI Brick's GE8300.
+
+  One display, the framebuffer's size and format; every window fills it, as
+  there is nothing to place a window on; the EGL surface is made with native
+  window 0, which the null window system takes as the display itself. Input
+  comes from the Linux input devices.
+*/
+#include "../../SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PVRFB
+
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "../SDL_sysvideo.h"
+#include "../../events/SDL_events_c.h"
+#ifdef SDL_INPUT_LINUXEV
+#include "../../core/linux/SDL_evdev.h"
+#endif
+#include "SDL_pvrfbvideo.h"
+
+static int PVRFB_VideoInit(_THIS)
+{
+    SDL_DisplayData *data;
+    SDL_VideoDisplay display;
+    SDL_DisplayMode mode;
+    struct fb_var_screeninfo info;
+    int fd = open("/dev/fb0", O_RDONLY | O_CLOEXEC);
+
+    if (fd < 0) {
+        return SDL_SetError("pvrfb: can't open /dev/fb0");
+    }
+    if (ioctl(fd, FBIOGET_VSCREENINFO, &info) < 0) {
+        close(fd);
+        return SDL_SetError("pvrfb: can't read the framebuffer's mode");
+    }
+    close(fd);
+
+    data = (SDL_DisplayData *)SDL_calloc(1, sizeof(*data));
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    data->width = info.xres;
+    data->height = info.yres;
+    data->bpp = info.bits_per_pixel;
+
+    SDL_zero(mode);
+    mode.w = data->width;
+    mode.h = data->height;
+    mode.format = data->bpp == 16 ? SDL_PIXELFORMAT_RGB565 : SDL_PIXELFORMAT_ARGB8888;
+    mode.refresh_rate = 60;
+
+    SDL_zero(display);
+    display.name = "PowerVR framebuffer";
+    display.desktop_mode = mode;
+    display.current_mode = mode;
+    display.driverdata = data;
+    if (SDL_AddVideoDisplay(&display, SDL_FALSE) < 0) {
+        return -1;
+    }
+#ifdef SDL_INPUT_LINUXEV
+    if (SDL_EVDEV_Init() < 0) {
+        return -1;
+    }
+#endif
+    return 0;
+}
+
+static void PVRFB_VideoQuit(_THIS)
+{
+#ifdef SDL_INPUT_LINUXEV
+    SDL_EVDEV_Quit();
+#endif
+}
+
+static void PVRFB_GetDisplayModes(_THIS, SDL_VideoDisplay *display)
+{
+    SDL_AddDisplayMode(display, &display->current_mode);
+}
+
+static int PVRFB_SetDisplayMode(_THIS, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return 0;
+}
+
+static int PVRFB_CreateWindow(_THIS, SDL_Window *window)
+{
+    SDL_DisplayData *display = SDL_GetDisplayDriverData(0);
+    SDL_WindowData *data = (SDL_WindowData *)SDL_calloc(1, sizeof(*data));
+
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    window->driverdata = data;
+
+    /* The whole screen, whatever was asked for */
+    window->x = window->y = 0;
+    window->w = window->windowed.w = display->width;
+    window->h = window->windowed.h = display->height;
+    window->flags |= SDL_WINDOW_FULLSCREEN;
+
+    /* The EGL surface is made with the first GL context, not here: by then
+     * SDL has settled the GL attributes, which a renderer may still change
+     * after the window is made */
+    data->egl_surface = EGL_NO_SURFACE;
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return 0;
+}
+
+static void PVRFB_DestroyWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = window->driverdata;
+
+    if (data) {
+        if (data->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_DestroySurface(_this, data->egl_surface);
+        }
+        SDL_free(data);
+    }
+    window->driverdata = NULL;
+}
+
+static void PVRFB_PumpEvents(_THIS)
+{
+#ifdef SDL_INPUT_LINUXEV
+    SDL_EVDEV_Poll();
+#endif
+}
+
+static int PVRFB_GLES_LoadLibrary(_THIS, const char *path)
+{
+    return SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, 0);
+}
+
+static SDL_GLContext PVRFB_GLES_CreateContext(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = window->driverdata;
+
+    if (data->egl_surface == EGL_NO_SURFACE) {
+        data->egl_surface = SDL_EGL_CreateSurface(_this, (NativeWindowType)0);
+        if (data->egl_surface == EGL_NO_SURFACE) {
+            SDL_SetError("pvrfb: can't create the EGL surface");
+            return NULL;
+        }
+    }
+    return SDL_EGL_CreateContext(_this, data->egl_surface);
+}
+
+SDL_EGL_SwapWindow_impl(PVRFB)
+SDL_EGL_MakeCurrent_impl(PVRFB)
+
+static void PVRFB_Destroy(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *PVRFB_Create(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(*device));
+
+    if (!device) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    device->free = PVRFB_Destroy;
+    device->VideoInit = PVRFB_VideoInit;
+    device->VideoQuit = PVRFB_VideoQuit;
+    device->GetDisplayModes = PVRFB_GetDisplayModes;
+    device->SetDisplayMode = PVRFB_SetDisplayMode;
+    device->CreateSDLWindow = PVRFB_CreateWindow;
+    device->DestroyWindow = PVRFB_DestroyWindow;
+    device->PumpEvents = PVRFB_PumpEvents;
+    device->GL_LoadLibrary = PVRFB_GLES_LoadLibrary;
+    device->GL_GetProcAddress = SDL_EGL_GetProcAddress;
+    device->GL_UnloadLibrary = SDL_EGL_UnloadLibrary;
+    device->GL_CreateContext = PVRFB_GLES_CreateContext;
+    device->GL_MakeCurrent = PVRFB_GLES_MakeCurrent;
+    device->GL_SetSwapInterval = SDL_EGL_SetSwapInterval;
+    device->GL_GetSwapInterval = SDL_EGL_GetSwapInterval;
+    device->GL_SwapWindow = PVRFB_GLES_SwapWindow;
+    device->GL_DeleteContext = SDL_EGL_DeleteContext;
+    return device;
+}
+
+VideoBootStrap PVRFB_bootstrap = {
+    "pvrfb",
+    "PowerVR on the Linux framebuffer",
+    PVRFB_Create,
+    NULL /* no ShowMessageBox */
+};
+
+#endif /* SDL_VIDEO_DRIVER_PVRFB */
diff -ruN a/src/video/pvrfb/SDL_pvrfbvideo.h b/src/video/pvrfb/SDL_pvrfbvideo.h
--- a/src/video/pvrfb/SDL_pvrfbvideo.h
+++ b/src/video/pvrfb/SDL_pvrfbvideo.h
@@ -0,0 +1,25 @@
+/*
+  PowerVR on the Linux framebuffer: SDL video for Imagination's EGL with the
+  null window system (libpvrNULL_WSEGL), as on the TrimUI Brick's GE8300.
+  There is no native window: EGL draws to the display behind /dev/fb0.
+*/
+#include "../../SDL_internal.h"
+
+#ifndef SDL_pvrfbvideo_h_
+#define SDL_pvrfbvideo_h_
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_egl_c.h"
+
+typedef struct SDL_DisplayData
+{
+    int width, height, bpp;
+} SDL_DisplayData;
+
+/* Named as SDL's EGL helpers expect */
+typedef struct SDL_WindowData
+{
+    EGLSurface egl_surface;
+} SDL_WindowData;
+
+#endif /* SDL_pvrfbvideo_h_ */
