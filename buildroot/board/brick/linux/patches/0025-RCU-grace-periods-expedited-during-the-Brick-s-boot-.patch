From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Mon, 12 Oct 2026 22:43:19 -0400
Subject: [PATCH] RCU grace periods expedited during the Brick's boot
 (RCU_EXPEDITE_BOOT, which 4.9 gives no prompt: now it has one): closing an
 input device waits for a grace period, about 40 ms at the normal pace on this
 kernel, and the system's init keeps them expedited after
 (/sys/kernel/rcu_expedited). SDL's joystick setup, which opens and closes
 each of the four input devices, went from 186 ms to 17, and TortOS's settings
 step, which does the same, from 168 ms to 1

---
 arch/arm64/configs/brick_defconfig | 1 +
 init/Kconfig                       | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/brick_defconfig b/arch/arm64/configs/brick_defconfig
index be29beab5..7c4af0e67 100644
--- a/arch/arm64/configs/brick_defconfig
+++ b/arch/arm64/configs/brick_defconfig
@@ -7,6 +7,7 @@ CONFIG_NO_HZ=y
 CONFIG_HIGH_RES_TIMERS=y
 CONFIG_BSD_PROCESS_ACCT=y
 CONFIG_BSD_PROCESS_ACCT_V3=y
+CONFIG_RCU_EXPEDITE_BOOT=y
 CONFIG_LOG_BUF_SHIFT=18
 CONFIG_BLK_DEV_INITRD=y
 # CONFIG_RD_BZIP2 is not set
diff --git a/init/Kconfig b/init/Kconfig
index c3a0922f6..6a385678d 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -830,7 +830,7 @@ config RCU_NOCB_CPU_ALL
 endchoice
 
 config RCU_EXPEDITE_BOOT
-	bool
+	bool "Expedite RCU grace periods during boot"
 	default n
 	help
 	  This option enables expedited grace periods at boot time,
