From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Mon, 12 Oct 2026 04:47:13 -0400
Subject: [PATCH] The TCS4838, the Brick's CPU supply: a regulator driver for
 its two outputs (dcdc0 on VSEL0, the CPU's; dcdc1 on VSEL1), 712.5 mV plus
 12.5 mV a step, bit 7 the enable, the CPU's kept in PWM mode as TrimUI keeps
 it. Without it the CPU sat at the chip's power-on 1.000 V and cpufreq never
 started, leaving the cores at the boot loader's 1008 MHz. On in
 brick_defconfig

---
 arch/arm64/configs/brick_defconfig |   1 +
 drivers/regulator/Kconfig          |   8 ++
 drivers/regulator/Makefile         |   1 +
 drivers/regulator/tcs4838.c        | 143 +++++++++++++++++++++++++++++
 4 files changed, 153 insertions(+)
 create mode 100644 drivers/regulator/tcs4838.c

diff --git a/arch/arm64/configs/brick_defconfig b/arch/arm64/configs/brick_defconfig
index 70cf454a7..ce2d972fc 100644
--- a/arch/arm64/configs/brick_defconfig
+++ b/arch/arm64/configs/brick_defconfig
@@ -249,6 +249,7 @@ CONFIG_REGULATOR=y
 CONFIG_REGULATOR_FIXED_VOLTAGE=y
 CONFIG_REGULATOR_VIRTUAL_CONSUMER=y
 CONFIG_REGULATOR_AXP2101=y
+CONFIG_REGULATOR_TCS4838=y
 CONFIG_MEDIA_SUPPORT=y
 CONFIG_MEDIA_CAMERA_SUPPORT=y
 CONFIG_MEDIA_CONTROLLER=y
diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 969788f31..12225fa7b 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -251,6 +251,14 @@ config REGULATOR_DB8500_PRCMU
 	  This driver supports the voltage domain regulators controlled by the
 	  DB8500 PRCMU
 
+config REGULATOR_TCS4838
+	tristate "TCS4838 buck regulator"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  The TCS4838 step-down regulator, the TrimUI Brick's CPU supply,
+	  with its two voltage settings as two outputs.
+
 config REGULATOR_FAN53555
 	tristate "Fairchild FAN53555 Regulator"
 	depends on I2C
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 01abbc7c1..fe9273d82 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -34,6 +34,7 @@ obj-$(CONFIG_REGULATOR_DA9211) += da9211-regulator.o
 obj-$(CONFIG_REGULATOR_DBX500_PRCMU) += dbx500-prcmu.o
 obj-$(CONFIG_REGULATOR_DB8500_PRCMU) += db8500-prcmu.o
 obj-$(CONFIG_REGULATOR_FAN53555) += fan53555.o
+obj-$(CONFIG_REGULATOR_TCS4838) += tcs4838.o
 obj-$(CONFIG_REGULATOR_GPIO) += gpio-regulator.o
 obj-$(CONFIG_REGULATOR_HI6421) += hi6421-regulator.o
 obj-$(CONFIG_REGULATOR_HI655X) += hi655x-regulator.o
diff --git a/drivers/regulator/tcs4838.c b/drivers/regulator/tcs4838.c
new file mode 100644
index 000000000..b950454bf
--- /dev/null
+++ b/drivers/regulator/tcs4838.c
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The TCS4838, the TrimUI Brick's CPU supply: a buck regulator on the PMIC's
+ * I2C bus (0x41). Without a driver the CPU runs at whatever voltage the chip
+ * powers up with (1.000 V) and cpufreq never starts, so the cores stay at the
+ * boot loader's 1008 MHz. With it, cpufreq-dt scales them on the device
+ * tree's table, as TrimUI's system does.
+ *
+ * Two outputs, one per voltage register, as TrimUI's device tree has them:
+ * dcdc0 on VSEL0 (0x00), the CPU's, and dcdc1 on VSEL1 (0x01), unused. Each
+ * register holds the enable in bit 7, the mode in bit 6 (set: always PWM)
+ * and a 6-bit step in bits 0-5: 712.5 mV + 12.5 mV a step. Register 0x03
+ * reads 0x88. All read from a Brick under TrimUI's system, which keeps
+ * VSEL0's mode bit set at every voltage (0xcf at 0.900 V, 0xeb at 1.250 V),
+ * so this does too.
+ */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define TCS4838_VSEL0		0x00
+#define TCS4838_VSEL1		0x01
+#define TCS4838_ID		0x03
+
+#define TCS4838_ENABLE		BIT(7)
+#define TCS4838_MODE_PWM	BIT(6)
+#define TCS4838_NSEL_MASK	0x3f
+
+/*
+ * No datasheet to hand for the slew rate, so a slow one: 2 mV/us puts the
+ * largest step on the table (0.900 to 1.250 V) at 175 us, well inside the
+ * device tree's 2 ms transition latency.
+ */
+#define TCS4838_RAMP_UV_PER_US	2000
+
+static const struct regulator_ops tcs4838_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+	.is_enabled		= regulator_is_enabled_regmap,
+};
+
+#define TCS4838_DESC(_id, _name, _reg)				\
+	{							\
+		.name		= _name,			\
+		.of_match	= of_match_ptr(_name),		\
+		.regulators_node = of_match_ptr("regulators"),	\
+		.id		= _id,				\
+		.ops		= &tcs4838_ops,			\
+		.type		= REGULATOR_VOLTAGE,		\
+		.owner		= THIS_MODULE,			\
+		.n_voltages	= TCS4838_NSEL_MASK + 1,	\
+		.min_uV		= 712500,			\
+		.uV_step	= 12500,			\
+		.vsel_reg	= _reg,				\
+		.vsel_mask	= TCS4838_NSEL_MASK,		\
+		.enable_reg	= _reg,				\
+		.enable_mask	= TCS4838_ENABLE,		\
+		.ramp_delay	= TCS4838_RAMP_UV_PER_US,	\
+	}
+
+static const struct regulator_desc tcs4838_regulators[] = {
+	TCS4838_DESC(0, "dcdc0", TCS4838_VSEL0),
+	TCS4838_DESC(1, "dcdc1", TCS4838_VSEL1),
+};
+
+static const struct regmap_config tcs4838_regmap_config = {
+	.reg_bits	= 8,
+	.val_bits	= 8,
+	.max_register	= TCS4838_ID,
+};
+
+static int tcs4838_probe(struct i2c_client *client,
+			 const struct i2c_device_id *id)
+{
+	struct regulator_config config = { };
+	struct regulator_dev *rdev;
+	struct regmap *regmap;
+	unsigned int chip_id;
+	int i, ret;
+
+	regmap = devm_regmap_init_i2c(client, &tcs4838_regmap_config);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	ret = regmap_read(regmap, TCS4838_ID, &chip_id);
+	if (ret) {
+		dev_err(&client->dev, "no answer at 0x%02x: %d\n", client->addr, ret);
+		return ret;
+	}
+	dev_info(&client->dev, "TCS4838, id 0x%02x\n", chip_id);
+
+	/* The CPU's output always in PWM, as TrimUI keeps it */
+	regmap_update_bits(regmap, TCS4838_VSEL0, TCS4838_MODE_PWM,
+			   TCS4838_MODE_PWM);
+
+	config.dev = &client->dev;
+	config.regmap = regmap;
+
+	for (i = 0; i < ARRAY_SIZE(tcs4838_regulators); i++) {
+		rdev = devm_regulator_register(&client->dev,
+					       &tcs4838_regulators[i], &config);
+		if (IS_ERR(rdev)) {
+			dev_err(&client->dev, "failed to register %s\n",
+				tcs4838_regulators[i].name);
+			return PTR_ERR(rdev);
+		}
+	}
+
+	return 0;
+}
+
+static const struct of_device_id tcs4838_of_match[] = {
+	{ .compatible = "ti,tcs4838" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tcs4838_of_match);
+
+static const struct i2c_device_id tcs4838_id[] = {
+	{ "tcs4838", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, tcs4838_id);
+
+static struct i2c_driver tcs4838_driver = {
+	.driver = {
+		.name		= "tcs4838",
+		.of_match_table	= of_match_ptr(tcs4838_of_match),
+	},
+	.probe		= tcs4838_probe,
+	.id_table	= tcs4838_id,
+};
+module_i2c_driver(tcs4838_driver);
+
+MODULE_DESCRIPTION("TCS4838 buck regulator, the TrimUI Brick's CPU supply");
+MODULE_LICENSE("GPL v2");
