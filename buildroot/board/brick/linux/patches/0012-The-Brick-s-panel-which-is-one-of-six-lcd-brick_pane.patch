+/*
+ * The gc9702c's table above came to TrimUI with two waits written another
+ * driver's way, a command of 0xfe with the milliseconds as its count (120).
+ * Their U-Boot sends those as writes of 0xfe; here they are the waits they
+ * were meant to be. Untested: no gc9702c Brick to try it on.
+ */
+
+struct brick_panel {
+	const char *name;
+	const u8 *init;
+};
+
+static const struct brick_panel brick_panels[] = {
+	{ "jd9168", jd9168_init },
+	{ "otm1289a", otm1289a_init },
+	{ "st7703", st7703_init },
+	{ "nv3052", nv3052_init },
+	{ "er68576", er68576_init },
+	{ "gc9702c", gc9702c_init },
+};
+
+/* What answered the ID read, kept so a second open skips the read. */
+static const struct brick_panel *found;
+
+static void LCD_power_on(u32 sel);
+static void LCD_power_off(u32 sel);
+static void LCD_bl_open(u32 sel);
+static void LCD_bl_close(u32 sel);
+static void LCD_panel_init(u32 sel);
+static void LCD_panel_exit(u32 sel);
+
+#define panel_reset(sel, val) sunxi_lcd_gpio_set_value(sel, 0, val)
+
+static void LCD_cfg_panel_info(struct panel_extend_para *info)
+{
+}
+
+static s32 LCD_open_flow(u32 sel)
+{
+	LCD_OPEN_FUNC(sel, LCD_power_on, 10);
+	LCD_OPEN_FUNC(sel, LCD_panel_init, 60);
+	LCD_OPEN_FUNC(sel, sunxi_lcd_tcon_enable, 50);
+	LCD_OPEN_FUNC(sel, LCD_bl_open, 0);
+	return 0;
+}
+
+static s32 LCD_close_flow(u32 sel)
+{
+	LCD_CLOSE_FUNC(sel, LCD_bl_close, 0);
+	LCD_CLOSE_FUNC(sel, sunxi_lcd_tcon_disable, 0);
+	LCD_CLOSE_FUNC(sel, LCD_panel_exit, 200);
+	LCD_CLOSE_FUNC(sel, LCD_power_off, 500);
+	return 0;
+}
+
+/* lcd_power0 is CLDO1 and lcd_power1 CLDO4; the reset is lcd_gpio_0, PD22 */
+static void LCD_power_on(u32 sel)
+{
+	sunxi_lcd_power_enable(sel, 0);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_power_enable(sel, 1);
+	sunxi_lcd_delay_ms(10);
+	sunxi_lcd_pin_cfg(sel, 1);
+	sunxi_lcd_delay_ms(50);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(120);
+	panel_reset(sel, 1);
+	sunxi_lcd_delay_ms(20);
+}
+
+static void LCD_power_off(u32 sel)
+{
+	sunxi_lcd_pin_cfg(sel, 0);
+	sunxi_lcd_delay_ms(20);
+	panel_reset(sel, 0);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 1);
+	sunxi_lcd_delay_ms(5);
+	sunxi_lcd_power_disable(sel, 0);
+}
+
+static void LCD_bl_open(u32 sel)
+{
+	sunxi_lcd_pwm_enable(sel);
+	sunxi_lcd_backlight_enable(sel);
+}
+
+static void LCD_bl_close(u32 sel)
+{
+	sunxi_lcd_backlight_disable(sel);
+	sunxi_lcd_pwm_disable(sel);
+}
+
+/*
+ * One ID register, as TrimUI reads it: the first byte set to 0xfe first, so
+ * a read that fails leaves something no panel's ID starts with.
+ */
+static void read_id(u32 sel, u8 reg, u8 id[4])
+{
+	u8 rx[32] = { 0xfe };
+	u32 num = 1;
+
+	sunxi_lcd_dsi_dcs_read(sel, reg, rx, &num);
+	memcpy(id, rx, 4);
+	pr_info("brick panel: 0x%02x = %02x %02x %02x %02x (%u)\n",
+		reg, id[0], id[1], id[2], id[3], num);
+}
+
+static const struct brick_panel *identify(u32 sel)
+{
+	u8 id[4], da[4], db[4], dc[4];
+
+	read_id(sel, 0x04, id);
+	read_id(sel, 0xda, da);
+	read_id(sel, 0xdb, db);
+	read_id(sel, 0xdc, dc);
+
+	switch (id[0]) {
+	case 0x00:
+		if (id[1] == 0x97 && id[2] == 0x02)
+			return &brick_panels[5];
+		break;
+	case 0x61:
+		if (id[1] == 0x00)
+			return &brick_panels[1];
+		break;
+	case 0xe8:
+		if (da[0] == 0xe8 && db[0] == 0x85 && dc[0] == 0x76)
+			return &brick_panels[4];
+		break;
+	case 0x38:
+		if (da[0] == 0x38 && db[0] == 0x21 && dc[0] == 0x1f)
+			return &brick_panels[2];
+		break;
+	case 0x30:
+		if (da[0] == 0x30 && db[0] == 0x52 && dc[0] == 0x03)
+			return &brick_panels[3];
+		break;
+	case 0x91:
+		if (da[0] == 0x91 && db[0] == 0x68 && dc[0] == 0x03)
+			return &brick_panels[0];
+		break;
+	}
+	return NULL;
+}
+
+static void LCD_panel_init(u32 sel)
+{
+	const u8 *p;
+
+	sunxi_lcd_dsi_clk_enable(sel);
+	if (!found) {
+		found = identify(sel);
+		if (found)
+			pr_info("brick panel: %s\n", found->name);
+		else {
+			pr_info("brick panel: unknown, sending jd9168's\n");
+			found = &brick_panels[0];
+		}
+		/* Off and on again before the commands, as TrimUI does */
+		LCD_power_off(sel);
+		LCD_power_on(sel);
+		sunxi_lcd_dsi_clk_enable(sel);
+	}
+
+	for (p = found->init; *p != END; ) {
+		if (*p == DELAY) {
+			sunxi_lcd_delay_ms(p[1]);
+			p += 2;
+		} else {
+			sunxi_lcd_dsi_dcs_write(sel, p[1], (u8 *)p + 2, p[0]);
+			p += 2 + p[0];
+		}
+	}
+}
+
+static void LCD_panel_exit(u32 sel)
+{
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x28);
+	sunxi_lcd_delay_ms(25);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x10);
+	sunxi_lcd_delay_ms(150);
+}
+
+static s32 LCD_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	return 0;
+}
+
+struct __lcd_panel brick_panel = {
+	.name = "otm1289a",
+	.func = {
+		.cfg_panel_info = LCD_cfg_panel_info,
+		.cfg_open_flow = LCD_open_flow,
+		.cfg_close_flow = LCD_close_flow,
+		.lcd_user_defined_func = LCD_user_defined_func,
+	},
+};
