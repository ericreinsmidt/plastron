+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The TrimUI Brick's panel, which is one of six. TrimUI has built the Brick
+ * with panels from different makers, each with its own controller, and their
+ * U-Boot asks the panel which it is before sending it anything: it reads the
+ * ID from DCS registers 0x04 and 0xda-0xdc, picks that controller's
+ * commands, powers the panel off and on again, and sends them. This does the
+ * same, with the same commands, timings and order, all taken from TrimUI's
+ * U-Boot (its OTM1289A driver, which despite the name holds all six). A
+ * panel that answers with none of the six IDs gets the JD9168's commands, as
+ * there.
+ *
+ * Registered as "otm1289a", the name TrimUI's device tree gives lcd0 on
+ * every Brick whatever its panel. TrimUI's U-Boot lit the panel and said so
+ * in the device tree (boot_disp, boot_fb0), and the kernel then left it
+ * alone; with our own boot loader those have to go, so disp2 runs this.
+ *
+ * The init tables are a count, a command and its parameters; a count of
+ * DELAY is a wait in milliseconds, END ends the table. The same two markers
+ * TrimUI's tables use.
+ */
+#include "brick_panel.h"
+#include "panels.h"
+
+#define DELAY	0xfe
+#define END	0xff
