From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Mon, 12 Oct 2026 04:47:13 -0400
Subject: [PATCH] cpufreq on the A133P: speed 0x8000 takes the c0 column (up to
 2 GHz), as TrimUI's kernel does on the Brick; this one predates it and took
 it for an A133 (a0 or a3, at most 1464 MHz, with more voltage than needed at
 each step). bin_ext is optional, as TrimUI's device tree has only speed and
 bin: without it nothing scaled

---
 drivers/cpufreq/sun50i-cpufreq-nvmem.c | 19 ++++++++++++++++---
 1 file changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/cpufreq/sun50i-cpufreq-nvmem.c b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
index b524aa53e..6d9794802 100644
--- a/drivers/cpufreq/sun50i-cpufreq-nvmem.c
+++ b/drivers/cpufreq/sun50i-cpufreq-nvmem.c
@@ -221,6 +221,15 @@ static void sun50iw10_bin_xlate(bool high_speed, char *name, u32 bin)
 static void sun50iw10_nvmem_xlate(u32 *versions, char *name)
 {
 	switch (ver_data.nv_speed) {
+	/*
+	 * The A133P, up to 2 GHz: its own column, c0, which TrimUI's kernel
+	 * picks on the Brick (it ran 2.0 GHz at 1.250 V there, a point only c0
+	 * has). This kernel predates it and took it for an A133, column a0 or
+	 * a3: at most 1464 MHz, and more voltage than it needs at each step.
+	 */
+	case 0x8000:
+		snprintf(name, MAX_NAME_LEN, "c0");
+		break;
 	case 0x0200:
 	case 0x0600:
 	case 0x0620:
@@ -295,9 +304,13 @@ static int sun50i_cpufreq_get_efuse(const struct cpufreq_soc_data *soc_data,
 		ptr = sun50i_nvmem_get_data("bin", &ver_data.nv_bin);
 		if (ptr)
 			return ptr;
-		ptr = sun50i_nvmem_get_data("bin_ext", &ver_data.nv_bin_ext);
-		if (ptr)
-			return ptr;
+		/*
+		 * Only tells a6 from the other A133 columns, and not in every
+		 * device tree: TrimUI's Brick has speed and bin alone. Without
+		 * it, taken as 0.
+		 */
+		if (sun50i_nvmem_get_data("bin_ext", &ver_data.nv_bin_ext))
+			ver_data.nv_bin_ext = 0;
 	}
 
 	soc_data->nvmem_xlate(versions, name);
