From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Sat, 10 Oct 2026 22:50:44 -0400
Subject: [PATCH] The SD card is found when the bootloader left it at 1.8 V:
 until a card answers, every other start is at 1.8 V. The bootloader switches
 the card to 1.8 V to read it at UHS speed and the card stays there until its
 power is cut, which never happens on a rail shared with USB and the lights; a
 fresh card still starts at 3.3 V on the next try

---
 drivers/mmc/host/sunxi-mmc.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index aea715165..4fea3088c 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -1369,6 +1369,8 @@ static void sunxi_mmc_hw_reset(struct mmc_host *mmc)
 	udelay(300);
 }
 
+static unsigned int sunxi_mmc_start_tries[4];
+
 static int sunxi_mmc_signal_voltage_switch(struct mmc_host *mmc,
 					   struct mmc_ios *ios)
 {
@@ -1409,6 +1411,18 @@ static int sunxi_mmc_signal_voltage_switch(struct mmc_host *mmc,
 
 	switch (ios->signal_voltage) {
 	case MMC_SIGNAL_VOLTAGE_330:
+		/* Until a card has answered, every other start is at 1.8 V. The
+		 * bootloader may have switched the card to 1.8 V to read it at
+		 * UHS speed, and it stays there until its power is cut, which a
+		 * rail shared with other parts never is; a fresh card starts at
+		 * 3.3 V. The core retries a start several times, so trying both
+		 * finds either. Once a card is there, requests are honoured. */
+		if (!mmc->card && host->phy_index < ARRAY_SIZE(sunxi_mmc_start_tries) &&
+		    (sunxi_mmc_start_tries[host->phy_index]++ & 1) == 0) {
+			dev_info(mmc_dev(mmc), "starting the card at 1.8V\n");
+			sunxi_sel_pio_mode(host->pinctrl, MMC_SIGNAL_VOLTAGE_180);
+			return 0;
+		}
 		if (!IS_ERR(vqmmc)) {
 			ret = regulator_set_voltage(vqmmc, 3300000, 3300000);
 			if (ret) {
