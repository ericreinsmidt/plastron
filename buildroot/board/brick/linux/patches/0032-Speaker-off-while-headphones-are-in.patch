From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Subject: [PATCH] The Brick's speaker goes silent while headphones are in: its
 amplifier runs only while the speaker's path is powered and no headphones are
 in, set from the path's power events and from the jack at every plug, under
 one lock. Headphones play from the codec's own output as before. The mute and
 level 0, which power the path down, still cut it

---
--- a/sound/soc/sunxi/sun50iw10-codec.h
+++ b/sound/soc/sunxi/sun50iw10-codec.h
@@ -15,6 +15,9 @@
  */
 #ifndef _SUN50IW10_CODEC_H
 #define _SUN50IW10_CODEC_H
+
+#include <linux/gpio.h>
+#include <linux/spinlock.h>
 
 #define SUNXI_CODEC_CPUDAI_RX_CHANNELS_MAX 2
 #define SUNXI_CODEC_CPUDAI_TX_CHANNELS_MAX 2
@@ -390,8 +393,38 @@
 	u32 pa_msleep;
 	bool used;
 	bool pa_level;
+	/* The speaker's path is powered (HpSpeaker), headphones are in, and
+	 * the lock both are changed under, as a plug and a mute can come at
+	 * once */
+	bool spk_on;
+	bool hp_in;
+	spinlock_t lock;
 };
 
+/*
+ * The speaker's amplifier, on while its path is powered and no headphones
+ * are in: headphones play from the codec's own output, and the speaker stays
+ * silent beside them. spk_on and hp_in are 0 or 1, or -1 to keep. The only
+ * writer of the amplifier's pin while sound plays: the path's event and the
+ * card's jack code both come here.
+ */
+static inline void sunxi_codec_spk_set(struct codec_spk_config *spk_cfg,
+				       int spk_on, int hp_in)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&spk_cfg->lock, flags);
+	if (spk_on >= 0)
+		spk_cfg->spk_on = spk_on;
+	if (hp_in >= 0)
+		spk_cfg->hp_in = hp_in;
+	if (spk_cfg->used)
+		gpio_set_value(spk_cfg->spk_gpio,
+			       spk_cfg->spk_on && !spk_cfg->hp_in ?
+			       spk_cfg->pa_level : !spk_cfg->pa_level);
+	spin_unlock_irqrestore(&spk_cfg->lock, flags);
+}
+
 struct sample_rate {
 	unsigned int samplerate;
 	unsigned int rate_bit;
--- a/sound/soc/sunxi/sun50iw10-codec.c
+++ b/sound/soc/sunxi/sun50iw10-codec.c
@@ -609,14 +609,13 @@
 			dachpf_enable(codec, 0);
 #endif
 		if (spk_cfg->used) {
-			gpio_set_value(spk_cfg->spk_gpio, spk_cfg->pa_level);
+			sunxi_codec_spk_set(spk_cfg, 1, -1);
 			/* time delay to wait spk pa work fine */
 			msleep(spk_cfg->pa_msleep);
 		}
 		break;
 	case	SND_SOC_DAPM_PRE_PMD:
-		if (spk_cfg->used)
-			gpio_set_value(spk_cfg->spk_gpio, !(spk_cfg->pa_level));
+		sunxi_codec_spk_set(spk_cfg, 0, -1);
 #ifdef SUNXI_CODEC_DAP_ENABLE
 		if (hw_cfg->dacdrc_cfg & DAP_SPK_EN)
 			dacdrc_enable(codec, 0);
@@ -1634,6 +1633,7 @@
 	}
 	dev_set_drvdata(&pdev->dev, sunxi_codec);
 	sunxi_codec->dev = &pdev->dev;
+	spin_lock_init(&sunxi_codec->spk_config.lock);
 
 	/* PA/SPK enable property */
 	ret = of_property_read_u32(np, "pa_level", &temp_val);
--- a/sound/soc/sunxi/sun50iw10-sndcodec.c
+++ b/sound/soc/sunxi/sun50iw10-sndcodec.c
@@ -174,6 +174,7 @@
 {
 	struct sunxi_card_priv *priv =
 		container_of(work, struct sunxi_card_priv, hs_detect_work.work);
+	struct sunxi_codec_info *codec_info = snd_soc_codec_get_drvdata(priv->codec);
 	int jack_type = 0, reg_val = 0;
 
 	mutex_lock(&priv->jack_mlock);
@@ -248,6 +249,10 @@
 				    (0x1 << MIC_DET_IRQ_EN));
 	}
 out:
+	/* And the speaker follows the plug: off while headphones are in, back
+	 * at unplug if its path is still powered */
+	sunxi_codec_spk_set(&codec_info->spk_config, -1,
+			    priv->detect_state == PLUG_IN);
 	mutex_unlock(&priv->jack_mlock);
 }
 
