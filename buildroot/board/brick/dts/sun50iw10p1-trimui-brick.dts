						regulator-ramp-delay = <0xfa>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x4a>;
					};

					reg_dcdc3: dcdc3 {
						regulator-name = "axp2202-dcdc3";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x1c1380>;
						regulator-ramp-delay = <0xfa>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x4b>;
					};

					reg_dcdc4: dcdc4 {
						regulator-name = "axp2202-dcdc4";
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0x387520>;
						regulator-ramp-delay = <0xfa>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x4c>;
					};

					reg_rtcldo: rtcldo {
						regulator-name = "axp2202-rtcldo";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x4d>;
					};

					reg_aldo1: aldo1 {
						regulator-name = "axp2202-aldo1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x4e>;
					};

					reg_aldo2: aldo2 {
						regulator-name = "axp2202-aldo2";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x4f>;
					};

					reg_aldo3: aldo3 {
						regulator-name = "axp2202-aldo3";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x50>;
					};

					reg_aldo4: aldo4 {
						regulator-name = "axp2202-aldo4";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x51>;
					};

					reg_bldo1: bldo1 {
						regulator-name = "axp2202-bldo1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x52>;
					};

					reg_bldo2: bldo2 {
						regulator-name = "axp2202-bldo2";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x53>;
					};

					reg_bldo3: bldo3 {
						regulator-name = "axp2202-bldo3";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-boot-on;
						regulator-always-on;
						regulator-off-in-suspend;
						phandle = <0x54>;
					};

					reg_bldo4: bldo4 {
						regulator-name = "axp2202-bldo4";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x55>;
					};

					reg_cldo1: cldo1 {
						regulator-name = "axp2202-cldo1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x56>;
					};

					reg_cldo2: cldo2 {
						regulator-name = "axp2202-cldo2";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x57>;
					};

					reg_cldo3: cldo3 {
						regulator-name = "axp2202-cldo3";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-ramp-delay = <0x9c4>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-boot-on;
						phandle = <0x2a>;
					};

					reg_cldo4: cldo4 {
						regulator-name = "axp2202-cldo4";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x58>;
					};

					reg_cpusldo: cpusldo {
						regulator-name = "axp2202-cpusldo";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x59>;
					};

					reg_vmid: vmid {
						regulator-name = "axp2202-vmid";
						regulator-enable-ramp-delay = <0x3e8>;
						phandle = <0x48>;
					};

					reg_drivevbus: drivevbus {
						regulator-name = "axp2202-drivevbus";
						regulator-enable-ramp-delay = <0x3e8>;
						drivevbusin-supply = <&reg_vmid>;
						phandle = <0x5a>;
					};
				};

				virtual-dcdc1 {
					compatible = "xpower-vregulator,dcdc1";
