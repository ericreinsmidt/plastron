			phandle = <0x1c>;
		};

		clk_de0: de0 {
			#clock-cells = <0x00>;
			compatible = "allwinner,periph-clock";
			assigned-clock-parents = <&clk_pll_periph0x2>;
			assigned-clock-rates = <0x11e1a300>;
			assigned-clocks = <&clk_de0>;
			clock-output-names = "de0";
			phandle = <0x0d>;
