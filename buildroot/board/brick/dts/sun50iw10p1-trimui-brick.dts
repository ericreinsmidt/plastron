		clk_pll_video1: pll_video1 {
			#clock-cells = <0x00>;
			compatible = "allwinner,fixed-factor-clock";
			clocks = <&clk_pll_video1x4>;
			clock-mult = <0x01>;
			clock-div = <0x04>;
			clock-output-names = "pll_video1";
