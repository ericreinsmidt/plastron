					pmu_bat_para18 = <0x48>;
					pmu_bat_para19 = <0x4b>;
					pmu_bat_para20 = <0x4d>;
					pmu_bat_para21 = <0x4f>;
					pmu_bat_para22 = <0x51>;
					pmu_bat_para23 = <0x55>;
					pmu_bat_para24 = <0x57>;
