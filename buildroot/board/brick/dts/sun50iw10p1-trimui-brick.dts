				};

				virtual-drivevbus {
					compatible = "xpower-vregulator,drivevbus";
					drivevbus-supply = <&reg_drivevbus>;
				};

				axp_gpio0: axp_gpio@0 {
					gpio-controller;
					#size-cells = <0x00>;
					#gpio-cells = <0x06>;
					status = "okay";
					phandle = <0x16e>;
				};
			};
		};

		twi0: twi@0x05002000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "allwinner,sun50i-twi";
			device_type = "twi0";
			reg = <0x00 0x5002000 0x00 0x400>;
			interrupts = <0x00 0x07 0x04>;
			clocks = <&clk_twi0>;
			clock-frequency = <0x61a80>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <&twi0_pins_a>;
			pinctrl-1 = <&twi0_pins_b>;
			status = "okay";
			phandle = <0x16f>;

		};


		twi2: twi@0x05002800 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "allwinner,sun50i-twi";
			device_type = "twi2";
			reg = <0x00 0x5002800 0x00 0x400>;
			interrupts = <0x00 0x09 0x04>;
			clocks = <&clk_twi2>;
			clock-frequency = <0x30d40>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <&twi2_pins_a>;
			pinctrl-1 = <&twi2_pins_b>;
			status = "okay";
			twi-supply = <&reg_aldo2>;
			twi_vol = <0x3567e0>;
			phandle = <0x171>;
		};





		usbc0: usbc0@0 {
			device_type = "usbc0";
			compatible = "allwinner,sunxi-otg-manager";
			usb_port_type = <0x02>;
			usb_detect_type = <0x01>;
			usb_id_gpio = <0x45 0x07 0x08 0x00 0x00 0xffffffff 0xffffffff>;
			usb_det_vbus_gpio = "axp_ctrl";
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0x00>;
			usb_luns = <0x03>;
			usb_serial_unique = <0x00>;
			usb_serial_number = "20080411";
			rndis_wceis = <0x01>;
			status = "okay";
			det_vbus_supply = <&usb_power_supply>;
			usbc-supply = <&reg_cldo3>;
			phandle = <0x176>;
		};

		udc: udc-controller@0x05100000 {
			compatible = "allwinner,sunxi-udc";
			reg = <0x00 0x5100000 0x00 0x1000 0x00 0x00 0x00 0x100 0x00 0x5200000 0x00 0x1000>;
			interrupts = <0x00 0x20 0x04>;
			clocks = <&clk_usbphy0 &clk_usbotg &clk_usbehci1 &clk_usbphy1>;
			status = "okay";
			det_vbus_supply = <&usb_power_supply>;
			udc-supply = <&reg_cldo3>;
			phandle = <0x177>;
		};



		usbc1: usbc1@0 {
			device_type = "usbc1";
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0x00>;
			status = "okay";
			phandle = <0x17a>;
		};



		codec: codec@0x05096000 {
			compatible = "allwinner,sunxi-internal-codec";
			reg = <0x00 0x5096000 0x00 0x32c>;
			clocks = <&clk_pll_audiox4 &clk_codec_dac_1x &clk_codec_adc_1x &clk_pll_com &clk_pll_comdiv5>;
			device_type = "codec";
			status = "okay";
			mic1gain = <0x1f>;
			mic2gain = <0x1f>;
			adcdrc_cfg = <0x02>;
			adchpf_cfg = <0x01>;
			dacdrc_cfg = <0x02>;
			dachpf_cfg = <0x00>;
			digital_vol = <0x00>;
			lineout_vol = <0x1a>;
			headphonegain = <0x00>;
			pa_level = <0x01>;
			pa_msleep_time = <0x28>;
			gpio-spk = <0x45 0x07 0x06 0x01 0x01 0x01 0x01>;
			avcc-supply = <&reg_aldo4>;
			cpvin-supply = <&reg_cldo1>;
			phandle = <0x7f>;
		};

		cpudai: cpudai-controller@0x050906000 {
			compatible = "allwinner,sunxi-internal-cpudai";
			reg = <0x00 0x5096000 0x00 0x32c>;
			status = "okay";
			phandle = <0x7e>;
		};

		sndcodec: sound@0 {
			compatible = "allwinner,sunxi-codec-machine";
			interrupts = <0x00 0x19 0x04>;
			sunxi,cpudai-controller = <0x7e>;
			sunxi,audio-codec = <0x7f>;
			/* 1, the codec's high detect mode, where TrimUI's tree says 0: at 0
			 * every plug reads backwards (headphones in at boot with the jack
			 * empty, out when plugged in); at 1 each one reads right, measured
			 * 2026-10-16 by setting the mode by hand and plugging in twice */
			hp_detect_case = <0x01>;
			device_type = "sndcodec";
			status = "okay";
			noheadphonemic = <0x01>;
			phandle = <0x17d>;
		};
















		ledc: ledc@0x05018000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "allwinner,sunxi-leds";
			reg = <0x00 0x5018000 0x00 0x100>;
			interrupts = <0x00 0x23 0x04>;
