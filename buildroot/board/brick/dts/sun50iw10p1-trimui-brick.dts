		ths: thermal_sensor {
			compatible = "allwinner,sun50iw10p1-ths";
			reg = <0x00 0x5070400 0x00 0x400>;
			clocks = <&clk_ths>;
			clock-names = "bus";
			nvmem-cells = <&ths_calib>;
			nvmem-cell-names = "calibration";
			#thermal-sensor-cells = <0x01>;
			phandle = <0xf0>;
		};

		thermal-zones {

			cpu_thermal_zone {
				polling-delay-passive = <0x1f4>;
				polling-delay = <0x3e8>;
				thermal-sensors = <&ths 0x00>;
				sustainable-power = <0x4b0>;
				k_po = <0x42>;
				k_pu = <0x84>;
				k_i = <0x00>;

				cpu_trips: trips {
					phandle = <0x1af>;

					cpu_threshold: trip-point@0 {
						temperature = <0xe290>;
						type = "passive";
						hysteresis = <0x00>;
						phandle = <0x1b0>;
					};

					cpu_target: trip-point@1 {
						temperature = <0xf618>;
						type = "passive";
						hysteresis = <0x00>;
						phandle = <0xf1>;
					};

					cpu_crit: cpu_crit@0 {
						temperature = <0x15f90>;
						type = "critical";
						hysteresis = <0x00>;
						phandle = <0x1b1>;
					};
				};

				cooling-maps {

					map0 {
						trip = <0xf1>;
						cooling-device = <&cpu0 0xffffffff 0xffffffff>;
						contribution = <0x400>;
					};
				};
			};

			gpu_thermal_zone {
				polling-delay-passive = <0x1f4>;
				polling-delay = <0x3e8>;
				thermal-sensors = <&ths 0x01>;
				sustainable-power = <0x44c>;
			};

			ddr_thermal_zone {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&ths 0x02>;
			};
		};


