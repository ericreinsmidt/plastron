					pmu_bat_para9 = <0x2e>;
					pmu_bat_para10 = <0x30>;
					pmu_bat_para11 = <0x32>;
					pmu_bat_para12 = <0x34>;
					pmu_bat_para13 = <0x37>;
					pmu_bat_para14 = <0x3b>;
					pmu_bat_para15 = <0x3f>;
