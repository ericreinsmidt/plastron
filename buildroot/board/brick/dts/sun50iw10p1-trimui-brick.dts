		partitions {
			device_type = "partitions";

			bootloader {
				device_type = "bootloader";
				offset = <0x400>;
				size = <0xc000>;
			};

			env {
				device_type = "env";
				offset = <0xc400>;
				size = <0x400>;
			};

			env-redund {
				device_type = "env-redund";
				offset = <0xc800>;
				size = <0x400>;
			};

			boot {
				device_type = "boot";
				offset = <0xcc00>;
				size = <0xc000>;
			};

			rootfs {
				device_type = "rootfs";
				offset = <0x18c00>;
				size = <0x118000>;
			};

			rootfs_data {
