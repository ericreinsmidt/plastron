			reset_ns = <0x54>;
			t1h_ns = <0x320>;
			t1l_ns = <0x1c2>;
			t0h_ns = <0x190>;
			t0l_ns = <0x352>;
			wait_time0_ns = <0x54>;
			wait_time1_ns = <0x54>;
			wait_data_time_ns = <0x927c0>;
			status = "okay";
			phandle = <0x187>;
		};



