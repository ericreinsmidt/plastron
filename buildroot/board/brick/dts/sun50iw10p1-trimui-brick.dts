		dma0: dma-controller@03002000 {
			compatible = "allwinner,sun50i-dma";
			reg = <0x00 0x3002000 0x00 0x1000>;
			interrupts = <0x00 0x2d 0x04>;
			clocks = <&clk_dma>;
			#dma-cells = <0x01>;
			phandle = <0x153>;
		};

		nsi0: nsi-controller@03100000 {
			compatible = "allwinner,sun50i-nsi";
			interrupts = <0x00 0x3f 0x04>;
			reg = <0x00 0x3100000 0x00 0x10000>;
			clocks = <&clk_pll_ddr &clk_mbus>;
			clock-frequency = <0x1ab3f000>;
			#nsi-cells = <0x01>;
			status = "okay";
			phandle = <0x154>;

			cpu {
				/* 1, as TrimUI's boot0 leaves it on their running system, where their
				 * tree says 0: at 0 the display misses its reads under load (broken
				 * rows, the DSI error counter climbing); at 1 it doesn't, measured
				 * 2026-10-12: 175 errors in 904 frames, then none */
				select = <0x01>;
			};

			gpu {
				select = <0x01>;
			};



		};








		soc_timer0: timer@03009000 {
			compatible = "allwinner,sun4i-a10-timer";
			device_type = "soc_timer";
			reg = <0x00 0x3009000 0x00 0x400>;
			interrupts = <0x00 0x33 0x04>;
			clocks = <&clk_hosc>;
			phandle = <0x159>;
		};

		rtc: rtc@07000000 {
			compatible = "allwinner,sunxi-rtc";
			device_type = "rtc";
			wakeup-source;
			auto_switch;
			reg = <0x00 0x7000000 0x00 0x200>;
			interrupts = <0x00 0x6c 0x04>;
			gpr_offset = <0x100>;
			gpr_len = <0x08>;
			gpr_cur_pos = <0x06>;
			phandle = <0x15a>;
		};

		wdt: watchdog@030090a0 {
			compatible = "allwinner,sun50i-wdt";
			reg = <0x00 0x30090a0 0x00 0x20>;
			interrupts = <0x00 0x35 0x04>;
			phandle = <0x15b>;
		};



		uart0: uart@05000000 {
			compatible = "allwinner,sun50i-uart";
			device_type = "uart0";
			reg = <0x00 0x5000000 0x00 0x400>;
			interrupts = <0x00 0x00 0x04>;
			clocks = <&clk_uart0>;
			pinctrl-names = "default\0sleep";
			pinctrl-1 = <&uart0_pins_b>;
			uart0_port = <0x00>;
			uart0_type = <0x02>;
			status = "okay";
			uart-supply = <&reg_cldo3>;
			phandle = <0x15e>;
			pinctrl-0 = <&uart0_pins_a>;
		};

		uart1: uart@05000400 {
			compatible = "allwinner,sun50i-uart";
			device_type = "uart1";
			reg = <0x00 0x5000400 0x00 0x400>;
			interrupts = <0x00 0x01 0x04>;
			clocks = <&clk_uart1>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <&uart1_pins_a>;
			pinctrl-1 = <&uart1_pins_b>;
			uart1_port = <0x01>;
			uart1_type = <0x04>;
			status = "okay";
			phandle = <0x15f>;
		};







		twi6: s_twi@0x07081400 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "allwinner,sun50i-twi";
			reg = <0x00 0x7081400 0x00 0x200>;
			interrupts = <0x00 0x71 0x04>;
			clocks = <&clk_stwi0>;
			clock-frequency = <0x30d40>;
			pinctrl-names = "default\0sleep";
			pinctrl-0 = <&s_twi0_pins_a>;
			pinctrl-1 = <&s_twi0_pins_b>;
			status = "okay";
			twi_drv_used = <0x00>;
			no_suspend = <0x01>;
			phandle = <0x166>;

			tcs0: tcs@41 {
				compatible = "ti,tcs4838";
				reg = <0x41>;
				status = "okay";
				tcs4838_delay = <0x00>;
				phandle = <0x167>;

				regulator1: regulators@1 {
					phandle = <0x168>;

					reg_tcs0: dcdc0 {
						regulator-name = "tcs4838-dcdc0";
						regulator-min-microvolt = <0xadf34>;
						regulator-max-microvolt = <0x16e360>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x102>;
					};

					reg_tcs1: dcdc1 {
						regulator-name = "tcs4838-dcdc1";
						regulator-min-microvolt = <0xadf34>;
						regulator-max-microvolt = <0x16e360>;
						phandle = <0x169>;
					};
				};
			};

			pmu0: pmu@34 {
				compatible = "x-powers,axp2202";
				reg = <0x34>;
				status = "okay";
				interrupts = <0x00 0x08>;
				interrupt-parent = <&nmi_intc>;
				x-powers,drive-vbus-en;
				pmu_reset = <0x01>;
				pmu_irq_wakeup = <0x01>;
				pmu_hot_shutdown = <0x01>;
				wakeup-source;
				phandle = <0x16a>;

				usb_power_supply: usb_power_supply {
					compatible = "x-powers,axp2202-usb-power-supply";
					status = "okay";
					pmu_usbpc_vol = <0x11f8>;
					pmu_usbpc_cur = <0x1f4>;
					pmu_usbad_vol = <0xfa0>;
					pmu_usbad_cur = <0x9c4>;
					pmu_usb_typec_used = <0x01>;
					det_acin_supply = <&gpio_power_supply>;
					pmu_acin_usbid_drv = <0x45 0x07 0x0c 0x00 0xffffffff 0xffffffff 0xffffffff>;
					pmu_vbus_det_gpio = <0x45 0x07 0x0d 0x00 0xffffffff 0xffffffff 0xffffffff>;
					phandle = <0x46>;
				};

				gpio_power_supply: gpio_power_supply {
					compatible = "x-powers,gpio-supply";
					status = "disabled";
					pmu_acin_det_gpio = <0x45 0x07 0x0e 0x00 0xffffffff 0xffffffff 0xffffffff>;
					det_usb_supply = <&usb_power_supply>;
					phandle = <0x44>;
				};

				bat_power_supply: bat-power-supply {
					compatible = "x-powers,axp2202-bat-power-supply";
					param = <0x47>;
					status = "okay";
					pmu_chg_ic_temp = <0x00>;
					pmu_pre_chg = <0x1c2>;
					pmu_battery_rdc = <0x93>;
					pmu_battery_cap = <0xbb8>;
					pmu_runtime_chgcur = <0x3e8>;
					pmu_suspend_chgcur = <0x79e>;
					pmu_shutdown_chgcur = <0x79e>;
					pmu_init_chgvol = <0x1068>;
					pmu_battery_warning_level1 = <0x05>;
					pmu_battery_warning_level2 = <0x00>;
					pmu_chgled_func = <0x00>;
					pmu_chgled_type = <0x00>;
					pmu_bat_para1 = <0x00>;
