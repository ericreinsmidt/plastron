#!/bin/sh
# The Brick's start, from inittab's sysinit, after the mounts: the card, the
# GPU, the pad, Diatom and TortOS, and the USB cable's network for bring-up.
# What the bring-up's rdinit did, less what an initramfs needed: the
# libraries are in /usr/lib with real links, the GPU's
# firmware and powervr.ini come with pvr-ge8300, the ALSA configuration with
# the root. Each step's time since the kernel started goes to /tmp/boot-times.
#
# The card's games partition, exFAT and labeled TORTOS as on the Pixel 2, is
# /mnt/SDCARD: TortOS, games, music, saves; a freshly written card gets it
# and TortOS on its first boot. The kernel
# modules and the two bring-up tools are in the root (/usr/lib/brick), so the
# partition the boot loader reads its files from isn't mounted at all.

SDCARD=/mnt/SDCARD
L=/usr/lib/brick

mark() { echo "$(cut -d' ' -f1 /proc/uptime) $1" >> /tmp/boot-times; }

# A card partition that wasn't unmounted cleanly is checked and repaired before
# it is mounted, as the Pixel's datapart does: Linux won't, and keeps the
# flag for good once it has mounted a dirty volume, however cleanly it is
# unmounted after. The flag is one bit of the boot sector, so a clean boot
# pays for reading one byte: on exFAT bit 1 of VolumeFlags (byte 106), on
# FAT32 bit 0 of byte 65.
repair() {
	case $2 in
	exfat) state=$(od -An -tu1 -j106 -N1 $1); dirty=$(( state & 2 )) ;;
	*) state=$(od -An -tu1 -j65 -N1 $1); dirty=$(( state & 1 )) ;;
	esac
	[ $dirty -eq 0 ] && return
	echo "brick: $1 was not unmounted cleanly; checking it" > /dev/kmsg
	if [ $2 = exfat ]; then fsck.exfat -p $1; else fsck.fat -a $1; fi > /dev/null 2>&1
	echo "brick: fsck.$2 finished with status $?" > /dev/kmsg
}

# A card partition's device, by its GPT name
part() {
	for p in /sys/class/block/mmcblk0p*; do
		grep -q "^PARTNAME=$1$" $p/uevent 2>/dev/null && echo /dev/${p##*/}
	done
}

# The card image holds the boot and root partitions; on its first boot the
# rest of the card becomes the games partition, as the Pixel 2's datapart does:
# right after root, on a 4 MiB boundary (the card's erase blocks), exFAT,
# labeled TORTOS, named tortos in the GPT. The image's backup GPT sits at the
# end of the image, not the card, so it moves to the card's end first.
games_create() {
	card=/dev/mmcblk0
	echo "brick: first boot, adding the games partition" > /dev/kmsg
	root=/sys/class/block/$(basename $(part plastron-root))
	start=$(( $(cat $root/start) + $(cat $root/size) ))
	start=$(( (start + 8191) / 8192 * 8192 ))
	sfdisk --quiet --relocate gpt-bak-std $card &&
	echo "start=$start, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=tortos" |
		sfdisk --quiet --append --no-reread $card &&
	partx --add --nr 3 $card &&
	mkfs.exfat -L TORTOS ${card}p3 > /dev/null || {
		echo "brick: couldn't add the games partition" > /dev/kmsg
		return
	}
	: > /tmp/games-new
	echo "brick: ${card}p3 formatted as exFAT, label TORTOS" > /dev/kmsg
	echo ${card}p3
}

# TortOS onto the card from the image (/usr/share/tortos/card): on the first
# boot, whenever it goes missing, and when the image's is newer, never an older
# one over a newer, as the Pixel 2's /etc/init.d/tortos does. Only adds: the
# player's games, saves and TortOS's own state stay. tortos.elf goes last,
# after a sync, so a copy cut short starts over at the next boot. SEED_V is
# the image's version, written in by board/brick/post-build.sh.
SEED=/usr/share/tortos/card
SEED_V=
version_of() {
	v=
	[ -f "$1" ] || return 1
	IFS=. read -r a b c < "$1"
	case "$a.$b.${c:-0}" in
	*[!0-9.]* | .* | *..*) return 1 ;;
	esac
	v=$((a * 1000000 + b * 1000 + ${c:-0}))
}
tortos_seed() {
	[ -f $SEED/TortOS/tortos.elf ] || return
	if [ -f $SDCARD/TortOS/tortos.elf ]; then
		[ -n "$SEED_V" ] || return
		version_of $SDCARD/TortOS/VERSION && [ "$SEED_V" -le "$v" ] && return
		echo "brick: the image carries a newer TortOS than the card; copying it" > /dev/kmsg
		rm -f $SDCARD/TortOS/tortos.elf
	else
		echo "brick: no TortOS on the card; copying it from the image" > /dev/kmsg
	fi
	mkdir -p $SDCARD/TortOS
	for f in $SEED/TortOS/* $SEED/TortOS/.[!.]*; do
		[ -e "$f" ] && [ "${f##*/}" != tortos.elf ] && cp -R "$f" $SDCARD/TortOS/
	done
	for d in $SEED/*; do
		[ "${d##*/}" != TortOS ] && cp -R "$d" $SDCARD/
	done
	sync
	cp $SEED/TortOS/tortos.elf $SDCARD/TortOS/ && sync
	echo "brick: TortOS copied onto the card" > /dev/kmsg
}

start() {
	# RCU grace periods expedited, as the kernel had them until now
	# (RCU_EXPEDITE_BOOT): closing an input device waits for one, about
	# 40 ms at the normal pace, and SDL's joystick setup closes each of the
	# four in turn, 186 ms of TortOS's start where it is 17 ms expedited
	# (measured 2026-10-12). Diatom does the same at every game.
	echo 1 > /sys/kernel/rcu_expedited
	# TortOS's boot animation, first: it draws from the moment the
	# framebuffer exists and steps aside when TortOS draws (splash-fb.c)
	splash &
	watchdog -t 4 /dev/watchdog 2>/dev/null
	mark init

	# The boot at full speed: the performance governor until TortOS has
	# drawn its first frame, then ondemand, which otherwise starts at 408 MHz
	# and is still ramping up while TortOS starts
	G=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
	(
		for i in $(seq 1 200); do [ -w $G ] && break; sleep 0.01; done
		echo performance > $G
		for i in $(seq 1 300); do grep -q "first frame" /tmp/tortos.log 2>/dev/null && break; sleep 0.05; done
		echo ondemand > $G
		mark "governor: ondemand"
	) &

	# The games partition: added over the rest of the card on the first boot
	# of a freshly written card, checked when it wasn't unmounted cleanly,
	# and given TortOS from the image when it has none or an older one
	mkdir -p $SDCARD
	games=$(part tortos)
	[ -n "$games" ] || games=$(games_create)
	if [ -n "$games" ]; then
		repair $games exfat
		mount -t exfat -o noatime $games $SDCARD
		[ -f /tmp/games-new ] && touch $SDCARD/.metadata_never_index
		tortos_seed
	fi
	mark card
	# The time before the kernel, from the timer that counts from reset
	[ -x $L/sincereset ] && $L/sincereset >> /tmp/boot-times

	# The GPU's own driver now; its display half (dc_sunxi) after the pad,
	# as it waits for the panel to finish powering up (about 0.85 s)
	insmod $L/pvrsrvkm.ko
	mark gpu
	# The pad, after the volume keys, power key and jack, which keep event0-2
	insmod $L/brick-pad.ko
	mark pad
	insmod $L/dc_sunxi.ko
	mark "gpu display"

	# The mute switch (PH19), exported for TortOS, which reads
	# /sys/class/gpio/gpio243/value: 1 when down. The direction is what makes
	# the pin an input: exported alone it stays disabled and reads a stale 1
	[ -d /sys/class/gpio/gpio243 ] || echo 243 > /sys/class/gpio/export
	echo in > /sys/class/gpio/gpio243/direction

	start_tortos
	mark tortos
	start_usb
	mark usb
}

# Diatom, then TortOS again whenever it ends, as launch.sh does, until it asks
# for the power to go off (Auto Off, or the power key)
start_tortos() {
	export TORTOS_DIR=$SDCARD/TortOS PLATFORM=tg3040 DEVICE=brick SDCARD_PATH=$SDCARD
	export BIOS_PATH=$SDCARD/Bios ROMS_PATH=$SDCARD/Roms SAVES_PATH=$SDCARD/Saves CHEATS_PATH=$SDCARD/Cheats
	export SYSTEM_PATH=$TORTOS_DIR CORES_PATH=$TORTOS_DIR/cores
	export USERDATA_PATH=$SDCARD/.userdata/tg3040 SHARED_USERDATA_PATH=$SDCARD/.userdata/shared
	export LOGS_PATH=$USERDATA_PATH/logs HOME=$USERDATA_PATH
	export SDL_VIDEODRIVER=pvrfb SDL_RENDER_DRIVER=opengles2
	export TORTOS_DIATOM_SOCKET=/tmp/diatom.sock
	mkdir -p $LOGS_PATH $SHARED_USERDATA_PATH
	cd $TORTOS_DIR
	./diatom --socket $TORTOS_DIATOM_SOCKET --cores $CORES_PATH \
		--save $SAVES_PATH --system $BIOS_PATH > /tmp/diatom.log 2>&1 &
	(
		while true; do
			rm -f /tmp/tortos_poweroff
			$L/backlight on
			./tortos.elf >> /tmp/tortos.log 2>&1
			[ -f /tmp/tortos_poweroff ] && break
			sleep 0.5
		done
		poweroff
	) &
	echo $! > /tmp/tortos-loop.pid
	cd /
}

# USB for bring-up: a network link on the cable, the Brick at 10.55.0.2 and
# the computer on the other end given 10.55.0.1, with no router, so its own
# internet is untouched. A shell over telnet, and over nc on 2323 in case
# telnetd dies. Never in a release: neither asks for a password.
start_usb() {
	for i in $(seq 1 150); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 0.1; done
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	mount -t configfs configfs /sys/kernel/config
	g=/sys/kernel/config/usb_gadget/brick
	mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
	echo 0x1d6b > $g/idVendor; echo 0x0104 > $g/idProduct
	echo plastron > $g/strings/0x409/manufacturer
	echo "Brick bring-up" > $g/strings/0x409/product
	echo brick0001 > $g/strings/0x409/serialnumber
	echo "bring-up" > $g/configs/c.1/strings/0x409/configuration
	mkdir -p $g/functions/ecm.usb0
	echo 02:62:72:69:63:01 > $g/functions/ecm.usb0/dev_addr
	echo 02:62:72:69:63:02 > $g/functions/ecm.usb0/host_addr
	ln -s $g/functions/ecm.usb0 $g/configs/c.1/
	if [ -n "$udc" ] && echo "$udc" > $g/UDC 2>/dev/null; then
		ifconfig usb0 10.55.0.2 netmask 255.255.255.0 up
		: > /tmp/udhcpd.leases
		udhcpd /etc/udhcpd.conf
		telnetd -F -l /bin/sh -b 10.55.0.2 > /tmp/telnetd.log 2>&1 &
		( while true; do nc -l -p 2323 -s 10.55.0.2 -e /bin/sh; sleep 0.2; done ) > /tmp/nc.log 2>&1 &
	else
		mark "usb: network didn't bind"
	fi
}

# TortOS and Diatom ahead of everything else at shutdown: the loop first, or
# it starts TortOS again
stop() {
	[ -f /tmp/tortos-loop.pid ] && kill $(cat /tmp/tortos-loop.pid) 2>/dev/null
	killall -TERM tortos.elf muse diatom 2>/dev/null
	for i in $(seq 1 20); do pidof diatom >/dev/null || break; sleep 0.1; done
}

# The card, waiting for the programs that ran from it to go, as the Pixel's
# datapart does: unmounted at once, it was often still busy, and every next
# boot found it marked as not properly unmounted
unmount() {
	grep -q " $SDCARD " /proc/mounts || return 0
	n=0
	until umount $SDCARD 2>/dev/null; do
		n=$((n + 1))
		if [ $n -ge 60 ]; then
			echo "brick: $SDCARD still in use after 3 s, left for the next boot to check" > /dev/kmsg
			return 1
		fi
		usleep 50000
	done
}

case "$1" in
start) start ;;
stop) stop ;;
unmount) unmount ;;
*) echo "usage: $0 start|stop|unmount" >&2; exit 1 ;;
esac
