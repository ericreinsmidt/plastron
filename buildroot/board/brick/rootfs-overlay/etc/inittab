# The Brick's inittab, in place of Buildroot's default, after the Pixel's
# (board/px2/rootfs-overlay/etc/inittab): no remount of / (rootswitch mounts
# it read-write), no swap, no getty (nothing on screen would show it).

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
# The card, the GPU, the pad, then Diatom and TortOS in the background, and
# the USB link: see the script
::sysinit:/etc/init.d/brick start
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname

# TortOS and Diatom first (Diatom saves the running game on SIGTERM), then
# everything else, then the card, then the root read-only, so the next boot
# has no journal to replay
::shutdown:/etc/init.d/brick stop
::shutdown:/bin/kill -TERM -1
::shutdown:/bin/usleep 200000
::shutdown:/etc/init.d/brick unmount
::shutdown:/bin/umount -a -r
