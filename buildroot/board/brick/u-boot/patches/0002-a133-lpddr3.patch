From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:52:57 -0400
Subject: [PATCH] LPDDR3 on the A133: a SUNXI_DRAM_A133_LPDDR3 choice with the
 timings the TrimUI Brick's boot0 leaves in the controller at 672 MHz (read
 from the running controller, so valid at that clock only), and boot0's mode
 registers, MR1 0x83 and MR2 0x1c for RL 14 / WL 8, which match the PHY
 latencies the driver already sets for LPDDR3; its MR2 of 0xa (RL 12 / WL 6)
 didn't. The Brick's memory is LPDDR3, two ranks on a 32-bit bus

---
 arch/arm/mach-sunxi/Kconfig                   |  8 ++++
 arch/arm/mach-sunxi/dram_sun50i_a133.c        |  5 +-
 arch/arm/mach-sunxi/dram_timings/Makefile     |  1 +
 .../arm/mach-sunxi/dram_timings/a133_lpddr3.c | 46 +++++++++++++++++++
 4 files changed, 58 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index b7ee14c6..069d1b71 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -689,6 +689,14 @@ config SUNXI_DRAM_A133_DDR4
 	  This option is the DDR4 timing used by the boot0 on A133 devices
 	  which use a DDR4 timing.
 
+config SUNXI_DRAM_A133_LPDDR3
+	bool "LPDDR3 boot0 timings on the A133 DRAM controller"
+	select SUNXI_DRAM_LPDDR3
+	depends on DRAM_SUN50I_A133
+	help
+	  This option is the LPDDR3 timing used by the boot0 on the TrimUI
+	  Brick, at 672 MHz.
+
 config SUNXI_DRAM_A133_LPDDR4
 	bool "LPDDR4 boot0 timings on the A133 DRAM controller"
 	select SUNXI_DRAM_LPDDR4
diff --git a/arch/arm/mach-sunxi/dram_sun50i_a133.c b/arch/arm/mach-sunxi/dram_sun50i_a133.c
index ca3e2513..261a342b 100644
--- a/arch/arm/mach-sunxi/dram_sun50i_a133.c
+++ b/arch/arm/mach-sunxi/dram_sun50i_a133.c
@@ -766,8 +766,9 @@ static void mctl_dfi_init(const struct dram_para *para)
 		mctl_mr_write(MRCTRL0_MR_ADDR(6), 0x862 & (~BIT(7)));
 		break;
 	case SUNXI_DRAM_TYPE_LPDDR3:
-		mctl_mr_write_lpddr3(1, 0xc3);	/* MR1: nWR=8, BL8 */
-		mctl_mr_write_lpddr3(2, 0xa);	/* MR2: RL=12, WL=6 */
+		/* As the TrimUI Brick's boot0: RL 14 / WL 8, as the PHY is set */
+		mctl_mr_write_lpddr3(1, 0x83);	/* MR1: BL8 */
+		mctl_mr_write_lpddr3(2, 0x1c);	/* MR2: RL=14, WL=8 */
 		mctl_mr_write_lpddr3(3, 0x2);	/* MR3: 40 0hms PD/PU */
 		mctl_mr_write_lpddr3(11, para->mr11);
 		break;
diff --git a/arch/arm/mach-sunxi/dram_timings/Makefile b/arch/arm/mach-sunxi/dram_timings/Makefile
index 5de9fd5a..c4a3ea0a 100644
--- a/arch/arm/mach-sunxi/dram_timings/Makefile
+++ b/arch/arm/mach-sunxi/dram_timings/Makefile
@@ -8,5 +8,6 @@ obj-$(CONFIG_SUNXI_DRAM_H616_LPDDR3)	+= h616_lpddr3.o
 obj-$(CONFIG_SUNXI_DRAM_H616_LPDDR4)	+= h616_lpddr4_2133.o
 obj-$(CONFIG_SUNXI_DRAM_A133_DDR4)	+= a133_ddr4.o
 obj-$(CONFIG_SUNXI_DRAM_A133_LPDDR4)	+= a133_lpddr4.o
+obj-$(CONFIG_SUNXI_DRAM_A133_LPDDR3)	+= a133_lpddr3.o
 obj-$(CONFIG_SUNXI_DRAM_A523_DDR3)	+= a523_ddr3.o
 obj-$(CONFIG_SUNXI_DRAM_A523_LPDDR4)	+= a523_lpddr4.o
diff --git a/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c b/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c
new file mode 100644
index 00000000..31d35213
--- /dev/null
+++ b/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * A133 LPDDR3 timings, as the TrimUI Brick's boot0 leaves the controller at
+ * 672 MHz: read from the running controller, not computed, so valid at that
+ * clock only.
+ */
+#include <asm/io.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/dram.h>
+
+void mctl_set_timing_params(const struct dram_para *para)
+{
+	struct sunxi_mctl_ctl_reg *const mctl_ctl =
+		(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+
+	writel(0x1011180f, &mctl_ctl->dramtmg[0]);
+	writel(0x00030318, &mctl_ctl->dramtmg[1]);
+	writel(0x04070d0c, &mctl_ctl->dramtmg[2]);
+	writel(0x0050500c, &mctl_ctl->dramtmg[3]);
+	writel(0x0902040a, &mctl_ctl->dramtmg[4]);
+	writel(0x05050503, &mctl_ctl->dramtmg[5]);
+	writel(0x02020005, &mctl_ctl->dramtmg[6]);
+	writel(0x00000202, &mctl_ctl->dramtmg[7]);
+	writel(0x04041004, &mctl_ctl->dramtmg[8]);
+	writel(0x00020208, &mctl_ctl->dramtmg[9]);
+	writel(0x000e0c05, &mctl_ctl->dramtmg[10]);
+	writel(0x440c021c, &mctl_ctl->dramtmg[11]);
+	writel(0x00000008, &mctl_ctl->dramtmg[12]);
+	writel(0x0a100002, &mctl_ctl->dramtmg[13]);
+	writel(0x0000004a, &mctl_ctl->dramtmg[14]);
+
+	writel(0x004f0112, &mctl_ctl->init[0]);
+	writel(0x01f20000, &mctl_ctl->init[1]);
+	writel(0x00000d05, &mctl_ctl->init[2]);
+	writel(0x0083001c, &mctl_ctl->init[3]);		/* MR1/MR2 */
+	writel(0x00020000, &mctl_ctl->init[4]);		/* MR3 */
+	writel(0x00100004, &mctl_ctl->init[5]);
+	writel(0, &mctl_ctl->init[6]);
+	writel(0, &mctl_ctl->init[7]);
+	writel(0, &mctl_ctl->dfimisc);
+
+	writel(0x0000066f, &mctl_ctl->rankctl);
+	writel(0x028c8006, &mctl_ctl->dfitmg0);
+	writel(0x00100202, &mctl_ctl->dfitmg1);
+	writel(0x00280047, &mctl_ctl->rfshtmg);
+}
