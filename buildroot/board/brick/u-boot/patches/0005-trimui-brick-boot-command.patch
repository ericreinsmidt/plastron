From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:06:48 -0400
Subject: [PATCH] The Brick's boot command runs boot.scr from the card's first
 partition (FAT) first, if it is there, and boots its kernel, initramfs and
 device tree from there when it isn't or it returns: the boot can then change
 on the card alone, with no new boot loader. U-Boot records its own timings in
 the device tree it hands Linux (bootstage), readable under
 /proc/device-tree/bootstage

---
 configs/trimui-brick_defconfig | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/configs/trimui-brick_defconfig b/configs/trimui-brick_defconfig
index ce9de1c4..bf4de91a 100644
--- a/configs/trimui-brick_defconfig
+++ b/configs/trimui-brick_defconfig
@@ -31,4 +31,7 @@ CONFIG_AXP_DCDC3_VOLT=1200
 CONFIG_BOOTDELAY=0
 CONFIG_ENV_IS_NOWHERE=y
 CONFIG_USE_BOOTCOMMAND=y
-CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:5 ${kernel_addr_r} brick/boot/Image && load mmc 0:5 ${ramdisk_addr_r} brick/boot/initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:5 ${fdt_addr_r} brick/boot/brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
+CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:1 ${scriptaddr} boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:1 ${kernel_addr_r} Image && load mmc 0:1 ${ramdisk_addr_r} initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
+CONFIG_BOOTSTAGE=y
+CONFIG_BOOTSTAGE_FDT=y
+CONFIG_BOOTSTAGE_RECORD_COUNT=60
