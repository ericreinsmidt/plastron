From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eric Reinsmidt <735251+ericreinsmidt@users.noreply.github.com>
Date: Mon, 12 Oct 2026 23:32:56 -0400
Subject: [PATCH] The Brick's U-Boot without what it never uses (EFI,
 networking, USB, the standard boot methods, ext4, unzip): 442 KB where it was
 628, which SPL reads at about 1.4 MB/s, so 135 ms less before U-Boot starts.
 The serial port at 1.5 Mbaud: nothing listens on it, and at 115200 U-Boot
 waited for every character of its messages to go out, 140 ms of the boot.
 Measured with bootstage and SPL timer marks: the kernel starts 1.42 s after
 reset, where it was 1.84. The defconfig is now as savedefconfig writes it

---
 configs/trimui-brick_defconfig | 37 ++++++++++++++++++++++++++--------
 1 file changed, 29 insertions(+), 8 deletions(-)

diff --git a/configs/trimui-brick_defconfig b/configs/trimui-brick_defconfig
index bf4de91a..a1d0c431 100644
--- a/configs/trimui-brick_defconfig
+++ b/configs/trimui-brick_defconfig
@@ -18,20 +18,41 @@ CONFIG_DRAM_SUNXI_TPR14=0x1e1e2020
 CONFIG_MACH_SUN50I_A133=y
 CONFIG_SUNXI_DRAM_A133_LPDDR3=y
 CONFIG_R_I2C_ENABLE=y
+CONFIG_ENV_VARS_UBOOT_CONFIG=y
 # CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+# CONFIG_EFI_LOADER is not set
+# CONFIG_BOOTSTD is not set
+CONFIG_SUPPORT_RAW_INITRD=y
+# CONFIG_DISTRO_DEFAULTS is not set
+CONFIG_BOOTSTAGE=y
+CONFIG_BOOTSTAGE_RECORD_COUNT=60
+CONFIG_BOOTSTAGE_FDT=y
+CONFIG_BOOTDELAY=0
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:5 ${scriptaddr} brick/boot/boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:5 ${kernel_addr_r} brick/boot/Image && load mmc 0:5 ${ramdisk_addr_r} brick/boot/initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:5 ${fdt_addr_r} brick/boot/brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
+CONFIG_LAST_STAGE_INIT=y
 CONFIG_SPL_I2C=y
+CONFIG_HUSH_PARSER=y
+# CONFIG_CMD_UNZIP is not set
+CONFIG_CMD_BIND=y
+CONFIG_CMD_PART=y
+CONFIG_CMD_SYSBOOT=y
+CONFIG_CMD_EXT2=y
+CONFIG_CMD_FAT=y
+CONFIG_CMD_FS_GENERIC=y
+CONFIG_ISO_PARTITION=y
+CONFIG_ENV_IS_NOWHERE=y
+# CONFIG_NET is not set
 CONFIG_SPL_SYS_I2C_LEGACY=y
 CONFIG_SYS_I2C_MVTWSI=y
 CONFIG_SYS_I2C_SLAVE=0x7f
 CONFIG_SYS_I2C_SPEED=400000
 CONFIG_AXP717_POWER=y
-CONFIG_AXP_I2C_ADDRESS=0x34
 CONFIG_AXP_DCDC2_VOLT=900
 CONFIG_AXP_DCDC3_VOLT=1200
-CONFIG_BOOTDELAY=0
-CONFIG_ENV_IS_NOWHERE=y
-CONFIG_USE_BOOTCOMMAND=y
-CONFIG_BOOTCOMMAND="if test -n ${fel_booted}; then source 0x43100000; fi; if load mmc 0:5 ${scriptaddr} brick/boot/boot.scr; then source ${scriptaddr}; fi; mw.l 0x03001128 0xd1303333; mw.l 0x03001160 0xc0014396; mw.l 0x03001178 0xc001eb85; mw.l 0x03001028 0xa9003100; mw.l 0x03001030 0xa8007403; mw.l 0x03001040 0xa8001803; mw.l 0x03001048 0xa8006203; mw.l 0x03001050 0xa8003701; mw.l 0x03001058 0xa8002301; mw.l 0x03001060 0xa9002401; mw.l 0x03001068 0xa8003101; mw.l 0x03001078 0xa9042701; if load mmc 0:5 ${kernel_addr_r} brick/boot/Image && load mmc 0:5 ${ramdisk_addr_r} brick/boot/initramfs.cpio.gz && setenv rdsize ${filesize} && load mmc 0:5 ${fdt_addr_r} brick/boot/brick.dtb; then fdt addr ${fdt_addr_r}; fdt resize 4096; fdt rsvmem add 0x40000000 0x40000; fdt set /soc@03000000/sdmmc@04022000 status disabled; setenv bootargs console=ttyS0,115200 loglevel=1 rdinit=/rdinit cma=64M; booti ${kernel_addr_r} ${ramdisk_addr_r}:${rdsize} ${fdt_addr_r}; fi"
-CONFIG_BOOTSTAGE=y
-CONFIG_BOOTSTAGE_FDT=y
-CONFIG_BOOTSTAGE_RECORD_COUNT=60
+CONFIG_BAUDRATE=1500000
+# CONFIG_USB is not set
+CONFIG_FAT_RENAME=y
+CONFIG_REGEX=y
+CONFIG_SPL_CRC8=y
+CONFIG_TOOLS_MKEFICAPSULE=y
