config BR2_PACKAGE_MESA3D_PX2
	bool "mesa3d-px2"
	depends on !BR2_PACKAGE_MESA3D
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_FORMAT_MODIFIER_PLANE_COUNT
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_DMA_BUF
	help
	  Mesa with only what the Pixel 2 needs: the Panfrost driver for its
	  Mali-G31, GBM and EGL for drawing straight to the display, and
	  OpenGL ES. Buildroot's own mesa3d ties Panfrost to building LLVM
	  and clang for the device, because Mesa 25.1 and later precompile
	  some Panfrost GPU kernels at build time. 25.0 doesn't, so this
	  package pins it.

if BR2_PACKAGE_MESA3D_PX2

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mesa3d-px2"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mesa3d-px2"

config BR2_PACKAGE_PROVIDES_LIBGBM
	default "mesa3d-px2"

endif
