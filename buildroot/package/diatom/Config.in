config BR2_PACKAGE_DIATOM
	bool "diatom"
	depends on BR2_PACKAGE_SDL2
	depends on BR2_PACKAGE_MESA3D_PX2 || BR2_PACKAGE_PVR_GE8300
	select BR2_PACKAGE_ZLIB
	help
	  Diatom, the libretro frontend TortOS runs games with, built
	  from its repository (mounted at /diatom in the build
	  container) with its Pixel 2 port, or its Brick port on the
	  TrimUI Brick's system.
