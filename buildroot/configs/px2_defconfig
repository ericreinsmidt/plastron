# GKD Pixel 2 (Rockchip RK3326S / PX30S): the base system. It boots, lights
# the screen, plays sound, reads the buttons and powers off, and nothing about
# it is TortOS's. TortOS goes on top: board/tortos/tortos.config, merged in by
# scripts/build.sh.

# CPU and toolchain. glibc, so prebuilt libretro cores and Diatom run as built.
BR2_aarch64=y
BR2_cortex_a35=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_15_X=y
BR2_KERNEL_HEADERS_6_19=y

# System: busybox init, devtmpfs, no udev
BR2_TARGET_GENERIC_HOSTNAME="px2"
BR2_TARGET_GENERIC_ISSUE="px2"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# No getty: see board/px2/rootfs-overlay/etc/inittab
# BR2_TARGET_GENERIC_GETTY is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PX2_PATH)/board/px2/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PX2_PATH)/board/px2/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PX2_PATH)/board/px2/post-image.sh"

# Kernel: kernel.org 7.1.2 with ROCKNIX's patches, config and device tree
# from their 20260901 release (the one that passed phase 0)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.2"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_PX2_PATH)/board/px2/patches/linux"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_PX2_PATH)/board/px2/linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3326s-gkd-pixel2"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Access over the USB cable
BR2_PACKAGE_DROPBEAR=y

# Images: ext4 root, FAT boot partition, one card image (see genimage.cfg)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_PX2_PATH)/board/px2/boot.cmd"

# Display test tools: modetest sets a mode and draws a pattern, to check the
# panel lights from userspace (the kernel leaves it dark; see boot.cmd)
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y

# Graphics: Mesa's Panfrost for the Mali-G31 (our package, see its Config.in),
# SDL2 drawing straight to the display with OpenGL ES, as TortOS will, and
# kmscube to test GPU to screen. (glmark2's DRM build needs udev, which this
# system doesn't have.)
BR2_PACKAGE_MESA3D_PX2=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_KMSCUBE=y
BR2_PACKAGE_SDLTEST=y

# A press of the power button shuts down cleanly
BR2_PACKAGE_POWERKEY=y
BR2_PACKAGE_JACKSWITCH=y

# Sound tools: amixer for the mixer controls, aplay and speaker-test for
# playback checks. TortOS talks to ALSA directly.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set

# The data partition for games and saves (rootfs-overlay/etc/init.d/
# S10datapart): sfdisk and partx add it on the first boot, mkfs.exfat
# formats it
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_EXFATPROGS=y
